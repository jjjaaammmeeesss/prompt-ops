[
  {
    "id": "manager_anger",
    "relation": "\u4e0a\u4e0b\u7ea7",
    "title": "\u9879\u76ee\u5ef6\u671f\u5f15\u53d1\u7ecf\u7406\u60c5\u7eea\u5931\u63a7",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u7ecf\u7406\uff1a\u8fd9\u4e2a\u9879\u76ee\u4f60\u53c8\u5ef6\u671f\u4e86\uff0c\u5ba2\u6237\u90a3\u8fb9\u50ac\u4e86\u591a\u5c11\u6b21\u4f60\u77e5\u9053\u5417\uff1f\n\u4f60\uff1a\u8fd9\u6b21\u7684\u5ef6\u671f\u662f\u56e0\u4e3a\u9700\u6c42\u4e34\u65f6\u53d8\u66f4\uff0c\u6211\u4eec\u5df2\u7ecf\u5728\u52a0\u73ed\u8d76\u4e86\u3002\n\u7ecf\u7406\uff1a\u9700\u6c42\u53d8\u66f4\uff1f\u90a3\u4e3a\u4ec0\u4e48\u4e0d\u63d0\u524d\u8ddf\u6211\u6c9f\u901a\uff1f\u4f60\u4f5c\u4e3a\u9879\u76ee\u8d1f\u8d23\u4eba\uff0c\u8fd9\u70b9\u9884\u89c1\u6027\u90fd\u6ca1\u6709\u5417\uff1f\n\u4f60\uff1a\u6211\u4e0a\u5468\u53d1\u90ae\u4ef6\u7ed9\u4f60\u4e86\uff0c\u4f60\u53ef\u80fd\u6ca1\u770b\u5230\u3002\n\u7ecf\u7406\uff1a\u522b\u4ec0\u4e48\u90fd\u602a\u6211\u6ca1\u770b\u90ae\u4ef6\uff01\u4f60\u662f\u89c9\u5f97\u6211\u5929\u5929\u95f2\u7740\u6ca1\u4e8b\u5c31\u76ef\u7740\u4f60\u7684\u90ae\u4ef6\u770b\uff1f\u6211\u624b\u5e95\u4e0b\u7ba1\u7740\u4e09\u4e2a\u56e2\u961f\uff0c\u4f60\u8fd9\u6837\u7529\u9505\u6709\u610f\u601d\u5417\uff1f\n\u4f60\uff1a\u6211\u4e0d\u662f\u7529\u9505\uff0c\u53ea\u662f\u8bf4\u660e\u60c5\u51b5\u3002\u73b0\u5728\u6211\u4eec\u56e2\u961f\u6bcf\u5929\u665a\u4e0a\u90fd\u5728\u52a0\u73ed\uff0c\u5468\u672b\u4e5f\u6ca1\u4f11\u606f\u3002\n\u7ecf\u7406\uff1a\u52a0\u73ed\u6709\u7528\u5417\uff1f\u8fd8\u4e0d\u662f\u4e00\u6837\u5ef6\u671f\uff01\u6211\u770b\u4f60\u5c31\u662f\u6839\u672c\u6ca1\u628a\u8fd9\u4e8b\u653e\u5fc3\u4e0a\uff0c\u80fd\u529b\u4e0d\u884c\u6001\u5ea6\u66f4\u4e0d\u884c\uff01\n\u4f60\uff1a\u6211\u89c9\u5f97\u4f60\u73b0\u5728\u60c5\u7eea\u6bd4\u8f83\u6fc0\u52a8\uff0c\u6211\u4eec\u7b49\u4f1a\u513f\u518d\u804a\u5427\uff0c\u6211\u5148\u53bb\u628a\u8fdb\u5ea6\u6574\u7406\u4e2a\u62a5\u544a\u7ed9\u4f60\u3002",
    "reference_popup": ""
  },
  {
    "id": "colleague_hint",
    "relation": "\u540c\u4e8b",
    "title": "\u8bdd\u91cc\u6709\u8bdd\u60f3\u8ba9\u5bf9\u65b9\u5e2e\u5fd9",
    "scene": "\u5bf9\u65b9",
    "dialogue": "\u4f60\uff1a\u4eca\u5929\u600e\u4e48\u6101\u7709\u82e6\u8138\u7684\uff1f\n\u540c\u4e8b\uff1a\u54ce\uff0c\u522b\u63d0\u4e86\uff0c\u624b\u5934\u8fd9\u4e2a\u65b9\u6848\u5ba2\u6237\u660e\u5929\u5c31\u8981\uff0c\u6211\u5bb6\u91cc\u7a81\u7136\u6709\u70b9\u6025\u4e8b\uff0c\u771f\u4e0d\u77e5\u9053\u600e\u4e48\u529e\u3002\n\u4f60\uff1a\u54e6\uff0c\u90a3\u80fd\u8c03\u6574\u5417\uff1f\u8ddf\u5ba2\u6237\u5546\u91cf\u4e0b\uff1f\n\u540c\u4e8b\uff1a\u8fd9\u4e2a\u5ba2\u6237\u7279\u522b\u96be\u641e\uff0c\u80af\u5b9a\u4e0d\u884c\u3002\u53ea\u80fd\u786c\u625b\u4e86\uff0c\u5927\u4e0d\u4e86\u901a\u5bb5\u5427\uff0c\u5c31\u662f\u6015\u8eab\u4f53\u5403\u4e0d\u6d88\uff0c\u4e0a\u6b21\u901a\u5bb5\u6211\u80c3\u75c5\u90fd\u72af\u4e86\u3002\n\u4f60\uff1a\u662f\u6709\u70b9\u60e8\u2026\u2026\u8981\u4e0d\u6211\u770b\u770b\u6211\u80fd\u5e2e\u4e0a\u4ec0\u4e48\uff1f\n\u540c\u4e8b\uff1a\u771f\u7684\u5417\uff1f\u90a3\u592a\u597d\u4e86\uff01\u5176\u5b9e\u4e3b\u8981\u5c31\u662f\u540e\u9762\u7684\u6570\u636e\u6574\u7406\u90e8\u5206\uff0c\u4f60\u8981\u662f\u80fd\u5e2e\u5fd9\u5c31\u6551\u4e86\u6211\u4e86\u3002\n\u4f60\uff1a\u884c\uff0c\u4f60\u53d1\u6211\uff0c\u6211\u4eca\u665a\u5e2e\u4f60\u5f04\u3002\n\u540c\u4e8b\uff1a\u592a\u611f\u8c22\u4e86\uff0c\u90a3\u6211\u4e0d\u5ba2\u6c14\u4e86\u3002",
    "reference_popup": ""
  },
  {
    "id": "friend_soft_boundary",
    "relation": "\u670b\u53cb",
    "title": "\u603b\u88ab\u670b\u53cb\u4f7f\u5524\u53c8\u4e0d\u6562\u62d2\u7edd",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u670b\u53cb\uff1a\u5468\u672b\u5e2e\u6211\u642c\u5bb6\u5457\uff0c\u6211\u4e1c\u897f\u591a\u4e00\u4e2a\u4eba\u641e\u4e0d\u5b9a\u3002\n\u4f60\uff1a\u554a\uff1f\u5468\u672b\u6211\u672c\u6765\u60f3\u53bb\u529e\u70b9\u4e8b\u2026\u2026\u7b97\u4e86\uff0c\u4e5f\u884c\u5427\uff0c\u51e0\u70b9\uff1f\n\u670b\u53cb\uff1a\u65e9\u4e0a\u516b\u70b9\uff0c\u4f60\u8fc7\u6765\u6b63\u597d\u3002\u5bf9\u4e86\uff0c\u4e0a\u6b21\u501f\u4f60\u7684\u4e94\u767e\u5757\uff0c\u6211\u4e0b\u4e2a\u6708\u53d1\u5de5\u8d44\u518d\u8fd8\u4f60\uff0c\u6700\u8fd1\u624b\u5934\u7d27\u3002\n\u4f60\uff1a\u6ca1\u4e8b\u6ca1\u4e8b\uff0c\u4e0d\u6025\u3002\u90a3\u4e2a\u2026\u2026\u5176\u5b9e\u6211\u6700\u8fd1\u4e5f\u6709\u70b9\u7d27\u5f20\uff0c\u8981\u4e0d\u4f60\u770b\u770b\u5148\u8fd8\u4e00\u70b9\uff1f\n\u670b\u53cb\uff1a\u771f\u6ca1\u6709\uff0c\u6709\u8fd8\u4e0d\u8fd8\u4f60\u5417\uff1f\u54b1\u4fe9\u8c01\u8ddf\u8c01\u554a\u3002\u8bb0\u5f97\u5468\u672b\u522b\u8fdf\u5230\u554a\u3002\n\u4f60\uff1a\u597d\u5427\uff0c\u77e5\u9053\u4e86\u3002",
    "reference_popup": ""
  },
  {
    "id": "couple_chase_dodge",
    "relation": "\u60c5\u4fa3",
    "title": "\u8ffd\u7740\u786e\u8ba4\u611f\u60c5\u4e00\u65b9\u8d8a\u60f3\u9003",
    "scene": "\u6a21\u5f0f",
    "dialogue": "\u4f60\uff1a\u4f60\u6700\u8fd1\u600e\u4e48\u56de\u6d88\u606f\u8fd9\u4e48\u6162\uff0c\u4ee5\u524d\u90fd\u662f\u79d2\u56de\u7684\u3002\n\u4f34\u4fa3\uff1a\u6ca1\u6709\u554a\uff0c\u6211\u5c31\u662f\u6700\u8fd1\u5de5\u4f5c\u5fd9\uff0c\u4f60\u522b\u591a\u60f3\u3002\n\u4f60\uff1a\u6bcf\u6b21\u90fd\u8bf4\u5fd9\uff0c\u5fd9\u5230\u8fde\u53d1\u4e2a\u8868\u60c5\u7684\u65f6\u95f4\u90fd\u6ca1\u6709\u5417\uff1f\u4f60\u662f\u4e0d\u662f\u70e6\u6211\u4e86\uff1f\n\u4f34\u4fa3\uff1a\u4f60\u4e0d\u8981\u8001\u662f\u778e\u60f3\uff0c\u6211\u5c31\u662f\u60f3\u6709\u70b9\u81ea\u5df1\u7684\u65f6\u95f4\uff0c\u6253\u6253\u6e38\u620f\u4ec0\u4e48\u7684\u3002\n\u4f60\uff1a\u90a3\u6211\u7ed9\u4f60\u53d1\u6d88\u606f\u4e5f\u4e0d\u5f71\u54cd\u4f60\u6253\u6e38\u620f\u554a\uff0c\u4f60\u5c31\u56de\u4e00\u4e0b\u600e\u4e48\u4e86\u3002\u4f60\u662f\u4e0d\u662f\u4e0d\u559c\u6b22\u6211\u4e86\uff1f\u76f4\u8bf4\u5427\u3002\n\u4f34\u4fa3\uff1a\u4f60\u53c8\u6765\u4e86\u2026\u2026\u4f60\u8fd9\u6837\u8bf4\u8ba9\u6211\u538b\u529b\u5f88\u5927\u4f60\u77e5\u9053\u5417\uff1f\n\u4f60\uff1a\u6211\u538b\u529b\u4e0d\u5927\u5417\uff1f\u6211\u5929\u5929\u5728\u7b49\u4f60\u6d88\u606f\u3002\n\u4f34\u4fa3\uff1a\u6211\u4eec\u80fd\u4e0d\u80fd\u522b\u6bcf\u6b21\u804a\u5929\u90fd\u53d8\u6210\u8fd9\u6837\uff1f\n\u4f60\uff1a\u53d8\u6210\u54ea\u6837\uff1f\u6211\u53ea\u662f\u60f3\u77e5\u9053\u4f60\u5728\u60f3\u4ec0\u4e48\u3002\n\u4f34\u4fa3\uff1a\u597d\u4e86\u597d\u4e86\uff0c\u6211\u9519\u4e86\u884c\u4e0d\u884c\uff0c\u4f60\u522b\u751f\u6c14\u4e86\u3002\u6211\u5148\u53bb\u6253\u628a\u6e38\u620f\uff0c\u7b49\u4e0b\u627e\u4f60\u3002",
    "reference_popup": ""
  },
  {
    "id": "couple_push_retreat",
    "relation": "\u592b\u59bb",
    "title": "\u6559\u80b2\u95ee\u9898\u4e0a\u7684\u903c\u8feb\u4e0e\u9000\u8ba9\u5faa\u73af",
    "scene": "\u6a21\u5f0f",
    "dialogue": "\u4f60\uff1a\u513f\u5b50\u7684\u6210\u7ee9\u53c8\u4e0b\u6ed1\u4e86\uff0c\u4f60\u5c31\u4e0d\u80fd\u7ba1\u7ba1\u5417\uff1f\u6bcf\u6b21\u90fd\u662f\u6211\u5f53\u574f\u4eba\u3002\n\u4f34\u4fa3\uff1a\u6211\u89c9\u5f97\u6210\u7ee9\u4e0d\u662f\u552f\u4e00\u91cd\u8981\u7684\uff0c\u4ed6\u6700\u8fd1\u7bee\u7403\u6253\u5f97\u633a\u597d\uff0c\u4e5f\u633a\u5f00\u5fc3\u7684\u3002\n\u4f60\uff1a\u5f00\u5fc3\uff1f\u4ed6\u73b0\u5728\u5f00\u5fc3\uff0c\u4ee5\u540e\u8003\u4e0d\u4e0a\u597d\u5b66\u6821\u770b\u4ed6\u8fd8\u5f00\u5fc3\u5f97\u8d77\u6765\u5417\uff01\u4f60\u80fd\u4e0d\u80fd\u6709\u70b9\u5371\u673a\u611f\uff1f\n\u4f34\u4fa3\uff1a\u597d\uff0c\u4f60\u8bf4\u5f97\u5bf9\uff0c\u6211\u5468\u672b\u627e\u4ed6\u8c08\u8c08\u884c\u4e86\u5427\u3002\n\u4f60\uff1a\u6bcf\u6b21\u90fd\u8bf4\u8c08\uff0c\u8c08\u4e00\u6b21\u7ba1\u4e09\u5929\uff0c\u7136\u540e\u53c8\u4e0d\u95fb\u4e0d\u95ee\u3002\u6211\u771f\u662f\u548c\u4f60\u6c9f\u901a\u8d39\u52b2\u3002\n\u4f34\u4fa3\uff1a\u90a3\u4f60\u8bf4\u600e\u4e48\u529e\uff0c\u6211\u542c\u4f60\u7684\u3002\u6211\u53c8\u4e0d\u662f\u6559\u80b2\u4e13\u5bb6\u3002\n\u4f60\uff1a\u4f60\u5c31\u8fd9\u79cd\u6001\u5ea6\uff0c\u4ec0\u4e48\u90fd\u542c\u6211\u7684\uff0c\u81ea\u5df1\u4e00\u70b9\u4e3b\u89c1\u6ca1\u6709\uff0c\u641e\u5f97\u597d\u50cf\u662f\u6211\u4e00\u4e2a\u4eba\u5e26\u5b69\u5b50\u3002\n\u4f34\u4fa3\uff1a\u6211\u914d\u5408\u4f60\u8fd8\u4e0d\u884c\uff1f\u6211\u4e0d\u8bf4\u4e86\u90fd\u662f\u9519\uff0c\u8bf4\u4e86\u4f60\u4e5f\u4e0d\u6ee1\u610f\u3002\n\u4f60\uff1a\u7b97\u4e86\uff0c\u8ddf\u4f60\u8bf4\u4e86\u4e5f\u767d\u8bf4\u3002\n\u4f34\u4fa3\uff1a\u55ef\uff0c\u6211\u5148\u53bb\u70ed\u996d\u3002",
    "reference_popup": ""
  },
  {
    "id": "mother_in_law_outburst",
    "relation": "\u5a46\u5ab3",
    "title": "\u5a46\u5a46\u6307\u8d23\u513f\u5ab3\u4e71\u82b1\u94b1\u60c5\u7eea\u4e0a\u5934",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u5a46\u5a46\uff1a\u4f60\u53c8\u5728\u62c6\u5feb\u9012\uff1f\u8fd9\u51e0\u5929\u6211\u770b\u5bb6\u91cc\u5feb\u9012\u76d2\u5b50\u90fd\u5806\u6210\u5c71\u4e86\u3002\n\u4f60\uff1a\u5988\uff0c\u90fd\u662f\u4e9b\u5bb6\u7528\u7684\u5c0f\u4e1c\u897f\uff0c\u8fd8\u6709\u7ed9\u5c0f\u5b9d\u4e70\u7684\u8863\u670d\u3002\n\u5a46\u5a46\uff1a\u5c0f\u5b9d\u8863\u670d\u5df2\u7ecf\u591f\u591a\u4e86\uff0c\u4f60\u4e70\u8fd9\u4e9b\u4e71\u4e03\u516b\u7cdf\u7684\u6709\u4ec0\u4e48\u7528\uff1f\u6211\u513f\u5b50\u6323\u70b9\u94b1\u5bb9\u6613\u5417\uff0c\u4f60\u5c31\u8fd9\u4e48\u7cdf\u8e4b\uff1f\n\u4f60\uff1a\u5988\uff0c\u6211\u81ea\u5df1\u4e5f\u6709\u5de5\u4f5c\uff0c\u8fd9\u82b1\u7684\u4e5f\u662f\u6211\u81ea\u5df1\u7684\u5de5\u8d44\u3002\n\u5a46\u5a46\uff1a\u4f60\u7684\u5de5\u8d44\u4e0d\u662f\u8fd9\u4e2a\u5bb6\u7684\u94b1\uff1f\u7ed3\u4e86\u5a5a\u8fd8\u5206\u8fd9\u4e48\u6e05\u695a\uff0c\u4f60\u5c31\u662f\u6ca1\u628a\u8fd9\u4e2a\u5bb6\u5f53\u5bb6\uff01\u4f60\u770b\u770b\u4f60\uff0c\u5316\u5986\u54c1\u4e00\u5806\uff0c\u8863\u670d\u4e00\u67dc\u5b50\uff0c\u6709\u4f60\u8fd9\u4e48\u8fc7\u65e5\u5b50\u7684\u5417\uff1f\n\u4f60\uff1a\u5988\uff0c\u6211\u4e70\u7684\u4e1c\u897f\u90fd\u662f\u6709\u7528\u7684\uff0c\u60a8\u4e0d\u80fd\u6bcf\u6b21\u90fd\u8fd9\u6837\u8bf4\u6211\u3002\n\u5a46\u5a46\uff1a\u6709\u7528\uff1f\u54ea\u4e2a\u6709\u7528\uff1f\u6211\u770b\u5c31\u662f\u8d25\u5bb6\uff01\u6211\u5f53\u521d\u5c31\u4e0d\u540c\u610f\u4ed6\u5a36\u4f60\u2026\u2026\n\u4f60\uff1a\u5988\uff0c\u60a8\u8fd9\u8bdd\u8fc7\u5206\u4e86\u3002\u6211\u5148\u56de\u623f\u95f4\u4e86\uff0c\u60a8\u51b7\u9759\u4e00\u4e0b\u5427\u3002",
    "reference_popup": ""
  },
  {
    "id": "adult_child_weak",
    "relation": "\u6210\u5e74\u5b50\u5973\u4e0e\u7236\u6bcd",
    "title": "\u5973\u513f\u4e0d\u6562\u62d2\u7edd\u7236\u4eb2\u5b89\u6392\u7684\u76f8\u4eb2",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u7236\u4eb2\uff1a\u5973\u513f\uff0c\u8fd9\u5468\u516d\u665a\u4e0a\u7559\u51fa\u6765\uff0c\u7ed9\u4f60\u4ecb\u7ecd\u7684\u90a3\u4e2a\u76f8\u4eb2\u5bf9\u8c61\u4ece\u56fd\u5916\u56de\u6765\uff0c\u4e00\u8d77\u5403\u4e2a\u996d\u3002\n\u4f60\uff1a\u7238\uff0c\u6211\u5468\u516d\u7ea6\u4e86\u670b\u53cb\u2026\u2026\n\u7236\u4eb2\uff1a\u63a8\u6389\uff01\u4f60\u90fd26\u4e86\uff0c\u8fd8\u5929\u5929\u8ddf\u670b\u53cb\u6df7\uff0c\u6b63\u4e8b\u4e0d\u5e72\u3002\u4eba\u5bb6\u5c0f\u4f19\u5b50\u6761\u4ef6\u597d\u5f97\u5f88\uff0c\u9519\u8fc7\u4f60\u53bb\u54ea\u627e\uff1f\n\u4f60\uff1a\u6211\u5176\u5b9e\u73b0\u5728\u8fd8\u4e0d\u60f3\u8c08\u604b\u7231\uff0c\u5de5\u4f5c\u521a\u7a33\u5b9a\u3002\n\u7236\u4eb2\uff1a\u5de5\u4f5c\u4ec0\u4e48\u65f6\u5019\u662f\u4e2a\u5934\uff1f\u5973\u4eba\u5bb6\u9752\u6625\u5c31\u8fd9\u51e0\u5e74\uff0c\u6211\u662f\u4f60\u7239\u6211\u80fd\u5bb3\u4f60\uff1f\u4f60\u5988\u8d70\u5f97\u65e9\uff0c\u6211\u5c31\u64cd\u5fc3\u4f60\u8fd9\u4e00\u4ef6\u4e8b\u3002\n\u4f60\uff1a\u597d\u5427\u2026\u2026\u90a3\u6211\u53bb\uff0c\u4f46\u60a8\u522b\u4e00\u4e0a\u6765\u5c31\u8ddf\u4eba\u5bb6\u63d0\u7ed3\u5a5a\u7684\u4e8b\u3002\n\u7236\u4eb2\uff1a\u8fd9\u4f60\u4e0d\u7528\u7ba1\uff0c\u6211\u5fc3\u91cc\u6709\u6570\u3002\u5bf9\u4e86\uff0c\u7a7f\u7cbe\u795e\u70b9\uff0c\u522b\u8001\u662f\u90a3\u8eab\u9ed1\u8863\u670d\u3002\n\u4f60\uff1a\u77e5\u9053\u4e86\u3002",
    "reference_popup": ""
  },
  {
    "id": "sibling_rescue_loop",
    "relation": "\u5144\u5f1f\u59d0\u59b9",
    "title": "\u54e5\u54e5\u603b\u662f\u66ff\u59b9\u59b9\u6536\u62fe\u70c2\u644a\u5b50",
    "scene": "\u6a21\u5f0f",
    "dialogue": "\u59b9\u59b9\uff1a\u54e5\uff0c\u6c5f\u6e56\u6551\u6025\uff01\u6211\u4fe1\u7528\u5361\u8fd8\u4e0d\u4e0a\u4e86\uff0c\u4f60\u80fd\u5148\u5e2e\u6211\u8fd8\u4e00\u4e0b\u5417\uff0c\u4e0b\u4e2a\u6708\u8fd8\u4f60\u3002\n\u4f60\uff1a\u53c8\u8fd8\u4e0d\u4e0a\u4e86\uff1f\u4e0a\u6b21\u4e0d\u662f\u521a\u5e2e\u4f60\u8fd8\u8fc7\u5417\uff1f\n\u59b9\u59b9\uff1a\u4e0a\u6b21\u662f\u610f\u5916\uff0c\u8fd9\u6b21\u662f\u771f\u7684\u5468\u8f6c\u4e0d\u5f00\u3002\u6211\u90a3\u517c\u804c\u8fd8\u6ca1\u53d1\u5de5\u8d44\uff0c\u5ba2\u6237\u62d6\u6b3e\u3002\n\u4f60\uff1a\u4f60\u6bcf\u6b21\u90fd\u8fd9\u4e2a\u7406\u7531\u3002\u4e0d\u662f\u6211\u8bf4\u4f60\uff0c\u82b1\u94b1\u80fd\u4e0d\u80fd\u6709\u70b9\u8ba1\u5212\uff1f\n\u59b9\u59b9\uff1a\u54ce\u5440\u6211\u77e5\u9053\u9519\u4e86\uff0c\u4f60\u5148\u6551\u6211\u8fd9\u6b21\uff0c\u4e0d\u7136\u5f71\u54cd\u5f81\u4fe1\u3002\u6c42\u6c42\u4e86\uff0c\u6700\u540e\u4e00\u6b21\u3002\n\u4f60\uff1a\u4f60\u4e0a\u6b21\u4e5f\u8bf4\u662f\u6700\u540e\u4e00\u6b21\u3002\u884c\u5427\u884c\u5427\uff0c\u591a\u5c11\u94b1\uff1f\n\u59b9\u59b9\uff1a\u516b\u5343\u3002\n\u4f60\uff1a\u516b\u5343\uff1f\uff01\u4f60\u5230\u5e95\u4e70\u4e86\u4ec0\u4e48\uff1f\n\u59b9\u59b9\uff1a\u5c31\u2026\u2026\u770b\u4e2d\u4e00\u4e2a\u5305\u6ca1\u5fcd\u4f4f\uff0c\u8fd8\u6709\u8ddf\u670b\u53cb\u51fa\u53bb\u73a9\u4e86\u8d9f\u3002\u54e5\u4f60\u4e0d\u4f1a\u89c1\u6b7b\u4e0d\u6551\u5427\uff1f\n\u4f60\uff1a\u6211\u771f\u670d\u4e86\u4f60\u4e86\uff0c\u8f6c\u8fc7\u53bb\u4e86\u3002\u59b9\u59b9\uff0c\u8fd9\u771f\u662f\u6700\u540e\u4e00\u6b21\u3002\n\u59b9\u59b9\uff1a\u8c22\u8c22\u54e5\uff01\u7231\u4f60\uff01\u653e\u5fc3\u5427\uff01",
    "reference_popup": ""
  },
  {
    "id": "roommate_unspoken",
    "relation": "\u5408\u79df\u5ba4\u53cb",
    "title": "\u4e0d\u6ee1\u5bf9\u65b9\u5e26\u4eba\u8fc7\u591c\u5374\u62d0\u5f2f\u62b9\u89d2",
    "scene": "\u5bf9\u65b9",
    "dialogue": "\u5ba4\u53cb\uff1a\u6700\u8fd1\u6ca1\u7761\u597d\u554a\uff0c\u770b\u4f60\u9ed1\u773c\u5708\u3002\n\u4f60\uff1a\u55ef\uff0c\u662f\u6709\u70b9\uff0c\u53ef\u80fd\u6700\u8fd1\u7761\u7720\u6bd4\u8f83\u6d45\u3002\u90a3\u4f4d\u670b\u53cb\u6628\u5929\u53c8\u8fc7\u6765\u4e86\u54c8\uff1f\n\u5ba4\u53cb\uff1a\u5bf9\uff0c\u6211\u4fe9\u770b\u4e86\u4e2a\u7535\u5f71\u6709\u70b9\u665a\uff0c\u4ed6\u5c31\u5728\u6c99\u53d1\u51d1\u5408\u4e86\u4e00\u665a\u3002\u6ca1\u5435\u5230\u4f60\u5427\uff1f\n\u4f60\uff1a\u8fd8\u597d\u8fd8\u597d\uff0c\u5c31\u662f\u591c\u91cc\u8d77\u6765\u559d\u6c34\u770b\u5ba2\u5385\u706f\u8fd8\u4eae\u7740\uff0c\u4ee5\u4e3a\u5fd8\u5173\u4e86\u3002\u5bf9\u4e86\uff0c\u54b1\u4eec\u662f\u4e0d\u662f\u6708\u5e95\u8981\u4ea4\u6c34\u7535\u8d39\u4e86\uff1f\n\u5ba4\u53cb\uff1a\u5bf9\uff0c\u6211\u8bb0\u7740\u5462\u3002\u8fd9\u4e2a\u6708\u7535\u8d39\u53ef\u80fd\u4f1a\u591a\u4e00\u4e9b\uff0c\u6211\u591a\u644a\u70b9\u3002\n\u4f60\uff1a\u4e0d\u662f\u7535\u8d39\u7684\u95ee\u9898\u2026\u2026\u6211\u662f\u60f3\u554a\uff0c\u54b1\u4eec\u5408\u79df\u5f53\u521d\u4e0d\u662f\u8bf4\u5c3d\u91cf\u4e0d\u5e26\u4eba\u8fc7\u591c\u5417\uff0c\u603b\u89c9\u5f97\u6709\u70b9\u4e0d\u65b9\u4fbf\u3002\n\u5ba4\u53cb\uff1a\u54e6\uff0c\u4f60\u89c9\u5f97\u4e0d\u65b9\u4fbf\u554a\uff1f\u4f60\u600e\u4e48\u4e0d\u65e9\u8bf4\uff0c\u6211\u4ee5\u540e\u63d0\u524d\u8ddf\u4f60\u5546\u91cf\u3002\u6211\u8fd8\u4ee5\u4e3a\u4f60\u4e0d\u4ecb\u610f\u5462\u3002\n\u4f60\uff1a\u6211\u4ee5\u4e3a\u4f60\u660e\u767d\u5462\uff0c\u5c31\u6ca1\u76f4\u8bf4\u3002\n\u5ba4\u53cb\uff1a\u4f60\u4e0d\u7528\u8fd9\u4e48\u7ed5\uff0c\u76f4\u63a5\u8bf4\u5c31\u884c\u3002\u4e0b\u6b21\u6211\u63d0\u524d\u6253\u62db\u547c\uff0c\u6216\u8005\u5c3d\u91cf\u4e0d\u8ba9\u4ed6\u8fc7\u6765\u3002",
    "reference_popup": ""
  },
  {
    "id": "partner_unspoken_need",
    "relation": "\u521b\u4e1a\u5408\u4f19\u4eba",
    "title": "\u4e00\u65b9\u60f3\u53c2\u4e0e\u66f4\u591a\u53c8\u4e0d\u597d\u610f\u601d\u660e\u8bf4",
    "scene": "\u5bf9\u65b9",
    "dialogue": "\u4f60\uff1a\u6700\u8fd1\u4ea7\u54c1\u6570\u636e\u4e0d\u9519\uff0c\u54b1\u4eec\u4e0b\u9636\u6bb5\u91cd\u5fc3\u4f60\u548b\u770b\uff1f\n\u5408\u4f19\u4eba\uff1a\u4f60\u89c9\u5f97\u5462\uff1f\u6211\u73b0\u5728\u4e3b\u8981\u7cbe\u529b\u90fd\u5728\u76ef\u4f9b\u5e94\u94fe\uff0c\u5e02\u573a\u90a3\u8fb9\u4f60\u4e00\u4e2a\u4eba\u884c\u4e0d\u884c\uff1f\n\u4f60\uff1a\u8fd8\u884c\uff0c\u5c31\u662f\u7d2f\u70b9\uff0c\u6211\u8001\u5a46\u90fd\u6709\u610f\u89c1\u4e86\uff0c\u5929\u5929\u89c1\u4e0d\u7740\u4eba\u3002\n\u5408\u4f19\u4eba\uff1a\u54c8\u54c8\uff0c\u521b\u4e1a\u561b\u90fd\u8fd9\u6837\u3002\u4e0d\u8fc7\u8bdd\u8bf4\u56de\u6765\uff0c\u6211\u8fd9\u8fb9\u4f9b\u5e94\u94fe\u5176\u5b9e\u4e5f\u5dee\u4e0d\u591a\u4e86\uff0c\u95f2\u4e0b\u6765\u6211\u90fd\u53ef\u4ee5\u5e2e\u4f60\u8dd1\u8dd1\u5ba2\u6237\u3002\n\u4f60\uff1a\u4e0d\u7528\u4e0d\u7528\uff0c\u4f60\u641e\u597d\u4f60\u7684\u5c31\u884c\u3002\n\u5408\u4f19\u4eba\uff1a\u6211\u662f\u89c9\u5f97\uff0c\u54b1\u4eec\u662f\u4e0d\u662f\u53ef\u4ee5\u628a\u5206\u5de5\u518d\u8c03\u8c03\uff0c\u611f\u89c9\u4f60\u90a3\u8fb9\u538b\u529b\u5927\uff0c\u6211\u8fd9\u8fb9\u53cd\u800c\u6709\u70b9\u4f7f\u4e0d\u4e0a\u52b2\uff0c\u633a\u4e0d\u597d\u610f\u601d\u7684\u3002\n\u4f60\uff1a\u554a\uff1f\u4f60\u89c9\u5f97\u6ca1\u4f7f\u4e0a\u52b2\uff1f\u54b1\u4e0d\u662f\u8bf4\u597d\u5404\u81ea\u8d1f\u8d23\u4e00\u644a\u5417\uff1f\n\u5408\u4f19\u4eba\uff1a\u8bf4\u662f\u8fd9\u4e48\u8bf4\uff0c\u4f46\u4f60\u90a3\u8fb9\u70ed\u706b\u671d\u5929\u7684\uff0c\u6211\u8fd9\u8fb9\u9636\u6bb5\u6027\u6536\u5c3e\u4e86\uff0c\u603b\u611f\u89c9\u5bf9\u516c\u53f8\u8d21\u732e\u4e0d\u591f\uff0c\u4f60\u660e\u767d\u5417\uff1f\n\u4f60\uff1a\u4f60\u662f\u4e0d\u662f\u60f3\u53c2\u4e0e\u5e02\u573a\u7684\u5de5\u4f5c\uff1f\u6211\u6ca1\u610f\u89c1\u554a\uff0c\u4f60\u60f3\u6765\u968f\u65f6\u6765\u3002\n\u5408\u4f19\u4eba\uff1a\u90a3\u6211\u5c31\u4e0d\u5ba2\u6c14\u4e86\uff0c\u660e\u5929\u5f00\u59cb\u8ddf\u4f60\u4e00\u8d77\u8dd1\u5ba2\u6237\u3002",
    "reference_popup": ""
  },
  {
    "id": "neighbor_noise",
    "relation": "\u90bb\u91cc",
    "title": "\u697c\u4e0a\u697c\u4e0b\u53cb\u597d\u534f\u5546\u7ec3\u7434\u65f6\u95f4",
    "scene": "\u5b89\u9759",
    "dialogue": "\u90bb\u5c45\uff1a\u4e0d\u597d\u610f\u601d\u554a\uff0c\u6211\u5973\u513f\u4e0b\u5468\u8981\u8003\u7ea7\uff0c\u8fd9\u51e0\u5929\u7ec3\u7434\u65f6\u95f4\u53ef\u80fd\u4f1a\u957f\u4e00\u70b9\uff0c\u4f1a\u4e0d\u4f1a\u5435\u5230\u4f60\u5bb6\uff1f\n\u4f60\uff1a\u6ca1\u4e8b\u59d0\uff0c\u6211\u4eec\u4e00\u822c\u90a3\u4e2a\u65f6\u95f4\u4e5f\u5728\u770b\u7535\u89c6\uff0c\u5f71\u54cd\u4e0d\u5927\u3002\u5979\u4e00\u822c\u7ec3\u5230\u51e0\u70b9\uff1f\n\u90bb\u5c45\uff1a\u665a\u4e0a\u516b\u70b9\u5de6\u53f3\u5c31\u505c\uff0c\u518d\u665a\u6211\u81ea\u5df1\u4e5f\u89c9\u5f97\u4e0d\u5408\u9002\u3002\n\u4f60\uff1a\u90a3\u5c31\u884c\uff0c\u516b\u70b9\u4e4b\u540e\u6b63\u597d\u6211\u4eec\u8981\u54c4\u5b69\u5b50\u7761\u89c9\uff0c\u4e4b\u524d\u6709\u70b9\u58f0\u97f3\u4e0d\u788d\u4e8b\u3002\u52a0\u6cb9\u554a\uff0c\u795d\u8003\u8bd5\u987a\u5229\u3002\n\u90bb\u5c45\uff1a\u592a\u611f\u8c22\u4e86\uff0c\u8003\u5b8c\u4e86\u8bf7\u4f60\u5bb6\u5403\u86cb\u7cd5\u3002\n\u4f60\uff1a\u54c8\u54c8\u5ba2\u6c14\u4e86\uff0c\u90bb\u91cc\u90bb\u5c45\u7684\u3002",
    "reference_popup": ""
  },
  {
    "id": "customer_rage",
    "relation": "\u5ba2\u670d\u4e0e\u5ba2\u6237",
    "title": "\u5ba2\u6237\u56e0\u4ea7\u54c1\u8d28\u91cf\u95ee\u9898\u60c5\u7eea\u7206\u53d1",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u5ba2\u6237\uff1a\u4f60\u4eec\u8fd9\u4e1c\u897f\u8d28\u91cf\u592a\u5dee\u4e86\uff01\u7528\u4e86\u4e0d\u5230\u4e00\u4e2a\u6708\u5c31\u574f\u4e86\uff0c\u4ec0\u4e48\u73a9\u610f\u513f\uff01\n\u4f60\uff1a\u5148\u751f\u975e\u5e38\u62b1\u6b49\uff0c\u7ed9\u60a8\u5e26\u6765\u4e0d\u597d\u7684\u4f53\u9a8c\u4e86\u3002\u60a8\u65b9\u4fbf\u8bf4\u4e00\u4e0b\u5177\u4f53\u662f\u4ec0\u4e48\u95ee\u9898\u5417\uff1f\n\u5ba2\u6237\uff1a\u5c4f\u5e55\u7a81\u7136\u5c31\u4e0d\u4eae\u4e86\uff01\u6211\u91cc\u9762\u8fd8\u6709\u91cd\u8981\u6587\u4ef6\uff0c\u803d\u8bef\u6211\u591a\u5c11\u4e8b\u4f60\u77e5\u9053\u5417\uff01\u4f60\u4eec\u5fc5\u987b\u7ed9\u6211\u4e00\u4e2a\u8bf4\u6cd5\uff01\n\u4f60\uff1a\u6211\u5b8c\u5168\u7406\u89e3\u60a8\u7684\u5fc3\u60c5\uff0c\u8fd9\u79cd\u60c5\u51b5\u786e\u5b9e\u8ba9\u4eba\u7740\u6025\u3002\u6211\u4eec\u8fd9\u8fb9\u53ef\u4ee5\u4e3a\u60a8\u5b89\u6392\u68c0\u6d4b\uff0c\u5982\u679c\u662f\u8d28\u91cf\u95ee\u9898\uff0c\u514d\u8d39\u6362\u65b0\u3002\n\u5ba2\u6237\uff1a\u68c0\u6d4b\u68c0\u6d4b\uff0c\u5c31\u77e5\u9053\u68c0\u6d4b\uff01\u6211\u8981\u76f4\u63a5\u6362\uff01\u6211\u82b1\u597d\u51e0\u5343\u4e70\u7684\u4e1c\u897f\uff0c\u4e00\u4e2a\u6708\u5c31\u574f\uff0c\u4f60\u8ba9\u6211\u600e\u4e48\u76f8\u4fe1\u4f60\u4eec\u54c1\u724c\uff1f\n\u4f60\uff1a\u5148\u751f\uff0c\u60a8\u5148\u6d88\u6d88\u6c14\u3002\u4e3a\u4e86\u6700\u5feb\u89e3\u51b3\u60a8\u7684\u95ee\u9898\uff0c\u6211\u53ef\u4ee5\u5e2e\u60a8\u7533\u8bf7\u7279\u6b8a\u901a\u9053\uff0c\u4f18\u5148\u5904\u7406\uff0c\u60a8\u770b\u8fd9\u6837\u53ef\u4ee5\u5417\uff1f\n\u5ba2\u6237\uff1a\u90a3\u5c31\u8d76\u7d27\u7684\uff01\u522b\u518d\u8ba9\u6211\u50ac\u4e86\uff01\u6211\u8ddf\u4f60\u4eec\u8bf4\uff0c\u8fd9\u6b21\u5904\u7406\u4e0d\u597d\u6211\u76f4\u63a512315\u6295\u8bc9\u3002\n\u4f60\uff1a\u597d\u7684\uff0c\u6211\u9a6c\u4e0a\u7ed9\u60a8\u5efa\u5355\uff0c\u52a0\u6025\u5904\u7406\uff0c\u7a0d\u540e\u77ed\u4fe1\u901a\u77e5\u60a8\u3002\u8bf7\u60a8\u4fdd\u6301\u7535\u8bdd\u7545\u901a\u3002\n\u5ba2\u6237\uff1a\u884c\u5427\u884c\u5427\uff0c\u5feb\u70b9\u3002",
    "reference_popup": ""
  },
  {
    "id": "teacher_care",
    "relation": "\u5e08\u751f",
    "title": "\u8001\u5e08\u5173\u5fc3\u6bd5\u4e1a\u751f\u5c31\u4e1a\u8ff7\u832b",
    "scene": "\u5b89\u9759",
    "dialogue": "\u8001\u5e08\uff1a\u6700\u8fd1\u770b\u4f60\u5728\u5b66\u6821\u5f85\u7740\uff0c\u8fd8\u6ca1\u79bb\u6821\uff1f\n\u4f60\uff1a\u8001\u5e08\uff0c\u6211\u8bba\u6587\u65e9\u8fc7\u4e86\uff0c\u5c31\u662f\u5de5\u4f5c\u8fd8\u6ca1\u5b9a\uff0c\u6709\u70b9\u8ff7\u832b\uff0c\u4e0d\u77e5\u9053\u7559\u8fd9\u4e2a\u57ce\u5e02\u8fd8\u662f\u56de\u8001\u5bb6\u3002\n\u8001\u5e08\uff1a\u8fd9\u5f88\u6b63\u5e38\uff0c\u6211\u5f53\u65f6\u6bd5\u4e1a\u4e5f\u614c\u4e86\u4e00\u9635\u3002\u4f60\u5185\u5fc3\u66f4\u503e\u5411\u54ea\u8fb9\uff1f\n\u4f60\uff1a\u5176\u5b9e\u60f3\u7559\uff0c\u4f46\u8fd9\u8fb9\u538b\u529b\u5927\uff0c\u53c8\u6015\u81ea\u5df1\u6df7\u4e0d\u51fa\u540d\u5802\u3002\n\u8001\u5e08\uff1a\u90a3\u4f60\u4e13\u4e1a\u80fd\u529b\u4e0d\u5dee\uff0c\u591a\u8bd5\u8bd5\u3002\u6709\u4ec0\u4e48\u9700\u8981\u6211\u63a8\u8350\u7684\uff0c\u53ef\u4ee5\u627e\u6211\u804a\u804a\u3002\n\u4f60\uff1a\u8c22\u8c22\u8001\u5e08\uff0c\u6211\u5c31\u89c9\u5f97\u6709\u79cd\u6bd5\u4e1a\u7126\u8651\uff0c\u6015\u8f9c\u8d1f\u5bb6\u91cc\u671f\u671b\u3002\n\u8001\u5e08\uff1a\u4e0d\u8981\u592a\u82db\u8d23\u81ea\u5df1\uff0c\u4e00\u6b65\u4e00\u6b65\u6765\u3002\u5148\u627e\u4e2a\u80fd\u7acb\u8db3\u7684\u5de5\u4f5c\uff0c\u4e0d\u6c42\u4e00\u6b65\u5230\u4f4d\u3002\n\u4f60\uff1a\u55ef\uff0c\u542c\u60a8\u8fd9\u4e48\u8bf4\u6211\u5b89\u5fc3\u591a\u4e86\u3002\u6211\u4e0b\u5468\u53bb\u9762\u8bd5\u4e24\u5bb6\uff0c\u8bd5\u8bd5\u770b\u3002\n\u8001\u5e08\uff1a\u633a\u597d\uff0c\u795d\u4f60\u987a\u5229\uff0c\u6709\u597d\u6d88\u606f\u544a\u8bc9\u6211\u3002",
    "reference_popup": ""
  },
  {
    "id": "online_friend_meetup",
    "relation": "\u7f51\u53cb\u9762\u57fa",
    "title": "\u521d\u6b21\u89c1\u9762\u7684\u6109\u5feb\u804a\u5929",
    "scene": "\u5b89\u9759",
    "dialogue": "\u4f60\uff1a\u6ca1\u8ba4\u9519\u4eba\u5427\uff1f\u6bd4\u7167\u7247\u4e0a\u7626\uff01\n\u7f51\u53cb\uff1a\u54c8\u54c8\u4f60\u597d\uff0c\u4f60\u5012\u662f\u6bd4\u7167\u7247\u4e0a\u9ad8\u3002\u8fd9\u5496\u5561\u9986\u771f\u4e0d\u597d\u627e\uff0c\u4f60\u7ed5\u4e86\u6ca1\uff1f\n\u4f60\uff1a\u7ed5\u4e86\u4e00\u5927\u5708\uff0c\u95ee\u4e86\u4fdd\u5b89\u624d\u627e\u5230\u3002\u4f60\u559d\u4ec0\u4e48\uff0c\u6211\u8bf7\u5ba2\u3002\n\u7f51\u53cb\uff1a\u51b0\u7f8e\u5f0f\u5427\u3002\u6ca1\u60f3\u5230\u771f\u4eba\u548c\u7f51\u4e0a\u804a\u5929\u611f\u89c9\u8fd8\u633a\u63a5\u8fd1\u7684\u3002\n\u4f60\uff1a\u662f\u5427\uff1f\u6211\u4e5f\u89c9\u5f97\u4e0d\u5c34\u5c2c\uff0c\u6211\u4ee5\u4e3a\u89c1\u9762\u4f1a\u51b7\u573a\u3002\u4f60\u5468\u672b\u4e00\u822c\u5e72\u561b\uff1f\n\u7f51\u53cb\uff1a\u64b8\u732b\u770b\u4e66\uff0c\u6216\u8005\u53bb\u63a2\u5496\u5561\u5e97\u3002\u4f60\u5462\uff1f\n\u4f60\uff1a\u6211\u6253\u6e38\u620f\u6bd4\u8f83\u591a\uff0c\u5076\u5c14\u722c\u5c71\u3002\u4e0b\u6b21\u53ef\u4ee5\u7ea6\u4e00\u8d77\u53bb\u722c\uff0c\u6211\u77e5\u9053\u4e00\u6761\u8def\u7ebf\u7279\u6f02\u4eae\u3002\n\u7f51\u53cb\uff1a\u53ef\u4ee5\u554a\uff0c\u6211\u4e5f\u597d\u4e45\u6ca1\u722c\u5c71\u4e86\u3002\u5230\u65f6\u5019\u6211\u5e26\u4e0a\u76f8\u673a\u3002\n\u4f60\uff1a\u5c31\u8fd9\u4e48\u5b9a\u4e86\uff0c\u5230\u65f6\u5019\u53eb\u4f60\u3002",
    "reference_popup": ""
  },
  {
    "id": "old_friend_loan",
    "relation": "\u8001\u53cb\u501f\u94b1",
    "title": "\u8001\u53cb\u5f00\u53e3\u501f\u94b1\u4e0d\u5fcd\u5fc3\u62d2\u7edd",
    "scene": "\u81ea\u5df1",
    "dialogue": "\u670b\u53cb\uff1a\u5144\u5f1f\uff0c\u6211\u9047\u5230\u70b9\u96be\u5904\uff0c\u80fd\u4e0d\u80fd\u501f\u6211\u4e94\u4e07\u5757\u94b1\u5468\u8f6c\u4e00\u4e0b\uff0c\u534a\u5e74\u8fd8\u4f60\u3002\n\u4f60\uff1a\u4e94\u4e07\u554a\u2026\u2026\u6211\u6700\u8fd1\u624b\u5934\u4e5f\u4e0d\u5bbd\u88d5\uff0c\u521a\u4ed8\u4e86\u623f\u79df\u548c\u8f66\u8d37\u3002\n\u670b\u53cb\uff1a\u6211\u77e5\u9053\uff0c\u6211\u4e5f\u662f\u5b9e\u5728\u6ca1\u529e\u6cd5\u624d\u8ddf\u4f60\u5f00\u53e3\u3002\u4f60\u770b\u80fd\u51d1\u591a\u5c11\uff0c\u4e09\u56db\u4e07\u4e5f\u884c\u3002\n\u4f60\uff1a\u6211\u770b\u770b\u5427\uff0c\u53ef\u80fd\u6700\u591a\u80fd\u51d1\u4e2a\u4e24\u4e07\u3002\n\u670b\u53cb\uff1a\u4e24\u4e07\u4e5f\u884c\uff0c\u5269\u4e0b\u7684\u6211\u518d\u627e\u522b\u4eba\u3002\u8c22\u4e86\u5144\u5f1f\uff0c\u8fd9\u4efd\u60c5\u6211\u8bb0\u7740\u3002\n\u4f60\uff1a\u6ca1\u4e8b\uff0c\u4f60\u5565\u65f6\u5019\u8981\uff1f\n\u670b\u53cb\uff1a\u8d8a\u5feb\u8d8a\u597d\uff0c\u660e\u5929\u884c\u5417\uff1f\n\u4f60\uff1a\u884c\u5427\u2026\u2026\u5176\u5b9e\u6211\u5de5\u8d44\u8fd8\u6ca1\u53d1\uff0c\u6211\u5148\u7528\u4fe1\u7528\u5361\u7ed9\u4f60\u5957\u73b0\uff0c\u4f60\u5230\u65f6\u5019\u4e00\u5b9a\u8fd8\u6211\uff0c\u4e0d\u7136\u6211\u5229\u606f\u538b\u529b\u633a\u5927\u3002\n\u670b\u53cb\uff1a\u653e\u5fc3\uff0c\u6211\u80af\u5b9a\u8fd8\u3002\u5144\u5f1f\u4f60\u6700\u9760\u8c31\u4e86\u3002\n\u4f60\uff1a\u54ce\u3002",
    "reference_popup": ""
  }
]